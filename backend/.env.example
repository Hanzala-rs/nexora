# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/nexora

# Meta WhatsApp Cloud API (secrets)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_API_VERSION=v21.0

# Booking (placeholders — confirm with Nexora)
BUSINESS_TIMEZONE=Asia/Riyadh
BUSINESS_WORKING_DAYS=sun,mon,tue,wed,thu
BOOKING_DAYS_AHEAD=7

# Tests only: separate database, wiped by the test suite
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/nexora_test
